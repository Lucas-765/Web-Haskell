cabal-version:      3.0
name:               haskellaula
version:            0.2.0.0
synopsis:           StudyHub: plataforma de grupos de estudo
license:            BSD-3-Clause
license-file:       LICENSE
author:             Lucas
maintainer:         lucasgsantos36@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable haskellaula
    import:           warnings
    main-is:          Main.hs
    other-modules:    Api
                      Banco
                      Tipos
    build-depends:    base,
                      aeson,
                      bcrypt,
                      bytestring,
                      directory,
                      servant,
                      servant-auth,
                      servant-auth-server,
                      servant-server,
                      sqlite-simple,
                      text,
                      time,
                      warp
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"